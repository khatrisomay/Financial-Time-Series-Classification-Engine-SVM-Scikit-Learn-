  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OptimizeRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "default": "RELIANCE"
          },
          "selected_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selected Features",
            "default": [
              "Open-Close",
              "High-Low",
              "RSI"
            ]
          },
          "kernel": {
            "type": "string",
            "title": "Kernel",
            "default": "rbf"
          }
        },
        "type": "object",
        "title": "OptimizeRequest"
      },
      "PredictRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "default": "RELIANCE"
          },
          "selected_features": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Selected Features",
            "default": [
              "Open-Close",
              "High-Low"
            ]
          },
          "split_percentage": {
            "type": "number",
            "title": "Split Percentage",
            "default": 0.8
          },
          "kernel": {
            "type": "string",
            "title": "Kernel",
            "default": "rbf"
          },
          "C": {
            "type": "number",
            "title": "C",
            "default": 1.0
          },
          "gamma": {
            "type": "string",
            "title": "Gamma",
            "default": "scale"
          },
          "degree": {
            "type": "integer",
            "title": "Degree",
            "default": 3
          }
        },
        "type": "object",
        "title": "PredictRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
